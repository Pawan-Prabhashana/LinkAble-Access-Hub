# LinkAble Access Hub — Web Dashboard Environment Configuration
# Copy this file to .env.local

# Backend API URL — update to match your running backend
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# If running from mobile or another device on same network:
# NEXT_PUBLIC_API_URL=http://192.168.8.141:8000

# Deployed backend (Render, Railway, etc.):
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
