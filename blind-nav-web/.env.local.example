# LinkAble Access Hub — Web Dashboard Environment Configuration
# Copy this file to .env.local

# ── Backend API URL ───────────────────────────────────────────────────────────
# Local development (default):
NEXT_PUBLIC_API_URL=http://localhost:8000

# Running from another device on the same WiFi network:
# NEXT_PUBLIC_API_URL=http://192.168.x.x:8000

# Production — set this to your deployed Render/Railway backend URL:
# NEXT_PUBLIC_API_URL=https://linkable-access-hub-backend.onrender.com
