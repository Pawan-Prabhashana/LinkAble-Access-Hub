# LinkAble Access Hub — Backend Environment Configuration
# Copy this file to .env and fill in your values

# ── OpenAI (optional) ────────────────────────────────────────────────────────
# Leave empty to use the rules-based engine (offline, always works)
# Set to your OpenAI API key to enable LLM-powered analysis and copilot
OPENAI_API_KEY=

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to 'true' to use shortened SLA windows for live demonstrations:
# CRITICAL=2min, HIGH=5min, MEDIUM=10min, LOW=20min
# Background SLA checker also runs every 15s instead of 30s
DEMO_MODE=false
