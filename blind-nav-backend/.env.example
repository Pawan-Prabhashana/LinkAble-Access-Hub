# LinkAble Access Hub — Backend Environment Configuration
# Copy this to .env and fill in your values

# ── OpenAI (optional) ────────────────────────────────────────────────────────
# Leave empty to use rules-based engine (offline, always works for demo)
# Set to your OpenAI API key to enable GPT-4o chat intake + LLM analysis
OPENAI_API_KEY=

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to 'true' for live demos:
# - Short SLA windows: CRITICAL=2min, HIGH=5min, MEDIUM=10min, LOW=20min
# - SLA checker runs every 15s instead of 30s
# - Auto-seeds demo data on startup if database is empty
DEMO_MODE=true

# ── Server ────────────────────────────────────────────────────────────────────
# PORT is set automatically by Render/Railway. Only override locally if needed.
# PORT=8000
