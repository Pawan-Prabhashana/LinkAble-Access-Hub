# LinkAble Access Hub — Backend Environment Configuration
# Copy this to .env and fill in your values

# ── OpenAI (optional) ────────────────────────────────────────────────────────
# Leave empty to use rules-based engine (offline, always works for demo)
# Set to your OpenAI API key to enable GPT-4o chat intake + LLM analysis
OPENAI_API_KEY=

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to 'true' for live demos:
# - Short SLA windows: CRITICAL=2min, HIGH=5min, MEDIUM=10min, LOW=20min
# - SLA checker runs every 15s instead of 30s
# - Auto-seeds demo data on startup if database is empty
DEMO_MODE=true

# ── Email Alerts (SMTP) ──────────────────────────────────────────────────────
# Real emails are sent when SMTP_EMAIL + SMTP_PASSWORD are set.
# Leave both empty to run in simulation mode (no emails sent, safe for demo).
#
# Gmail setup:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to https://myaccount.google.com/security → App Passwords
#   3. Generate an App Password for "Mail"
#   4. Use that 16-character password as SMTP_PASSWORD (not your main Gmail password)

SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Comma-separated list of email addresses to receive alerts.
# Defaults to pawanprabhashana11@gmail.com if not set.
ALERT_EMAIL_TO=pawanprabhashana11@gmail.com

# ── Server ────────────────────────────────────────────────────────────────────
# PORT is set automatically by Render/Railway. Only override locally if needed.
# PORT=8000
